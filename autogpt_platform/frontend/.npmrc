# Configure pnpm to save exact versions
save-exact=true
engine-strict=true
minimum-release-age=10080

# The private @autogpt scope (e.g. @autogpt/icons) resolves from npm.
# Auth is NOT set here: pnpm ignores env-var credentials in a committed project
# .npmrc for security. Provide the token via a user-level ~/.npmrc that expands
# ${NPM_TOKEN} (see Dockerfile / CI). @autogpt/icons is an optionalDependency,
# so without a token install still succeeds and Icon falls back to Phosphor.
@autogpt:registry=https://registry.npmjs.org/