# Better Auth (runs inside this Next.js app at /api/auth/*)
# Dev-only default. MUST be overridden with a real secret in production.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-9f4e8c2a71b6d05e3a8f12c4b7d9e6a1
BETTER_AUTH_URL=http://localhost:3000
# Postgres connection for Better Auth; tables live in the platform schema
# (created by the backend's Prisma migrations).
DATABASE_URL=postgresql://postgres:your-super-secret-and-long-postgres-password@localhost:5432/postgres
AUTH_DB_SCHEMA=platform
# Set to true to block sign-in until the email is verified. There is no SMTP
# setting here: auth emails are sent by the backend's Postmark mailer (see the
# note below), so configure POSTMARK_* in backend/.env before enabling this.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Signup gating (env-driven; replaces the old DB allowlist trigger).
# Prod leaves both unset = open signup. Dev/preview sets the allowlist so
# randoms can't register on a public preview URL.
#   AUTH_ALLOW_NEW_ACCOUNTS  "false" blocks ALL new signups. Default: open.
#   AUTH_SIGNUP_ALLOWLIST    comma-separated allowed emails and @domains;
#                            empty/unset = open. e.g. "@agpt.co,me@example.com"
# AUTH_ALLOW_NEW_ACCOUNTS=true
# AUTH_SIGNUP_ALLOWLIST=

# Social login providers (enabled when both values of a pair are set)
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_DISCORD_CLIENT_ID=
# AUTH_DISCORD_CLIENT_SECRET=

# Better Auth verification / password-reset emails are sent through the backend
# mailer (Postmark) via POST {backend}/api/auth-email/send, authenticated with a
# short-lived service token signed by the Better Auth JWKS key the backend
# already trusts (JWT_JWKS_URL) — nothing to configure here. If the send fails
# outside production (e.g. no local Postmark), the link is logged to the server
# console instead.

# Only needed to bridge pre-migration Supabase sessions: keep the old GoTrue
# JWT secret set during the migration window so existing logins carry over.
# SUPABASE_JWT_SECRET=
# SUPABASE_BRIDGE_MAX_TOKEN_AGE_DAYS=30

# Back-end services
NEXT_PUBLIC_AGPT_SERVER_URL=http://localhost:8006/api
NEXT_PUBLIC_AGPT_WS_SERVER_URL=ws://localhost:8001/ws
NEXT_PUBLIC_FRONTEND_BASE_URL=http://localhost:3000

# Env config
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_BEHAVE_AS=LOCAL

# Feature flags
NEXT_PUBLIC_LAUNCHDARKLY_ENABLED=false
NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_ID=687ab1372f497809b131e06e

# Debugging
NEXT_PUBLIC_REACT_QUERY_DEVTOOL=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FH2XK2W4GN

# Google Drive Picker
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Cloudflare CAPTCHA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE=disabled

# PR previews
NEXT_PUBLIC_PREVIEW_STEALING_DEV=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# DataFast server-side goal tracking (Website Settings > API, df_ key)
DATAFAST_API_KEY=

# Web Push VAPID public key (same as backend VAPID_PUBLIC_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BBg49iVTWthVbRYphwmZNvZyiSJDqtSO4nmLxDzLKe3Oo9jbtu0Usa14xX4HQQNLUeiEfzD42zWSlrvY1PR12bs

# OpenAI (for voice transcription)
OPENAI_API_KEY=

# Voice brain-dump onboarding step (`onboarding-brain-dump` LaunchDarkly
# flag). Commented deliberately: an active value here would ship the feature
# on to every install. Uncomment in your own .env, pair it with
# FORCE_FLAG_ONBOARDING_BRAIN_DUMP in backend/.env, and restart the dev
# server — NEXT_PUBLIC_* vars are inlined at build time.
# NEXT_PUBLIC_FORCE_FLAG_ONBOARDING_BRAIN_DUMP=true
