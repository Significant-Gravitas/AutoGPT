{
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "ui": "@/components/atoms",
      "componentImports": ["^@/components/(molecules|organisms)(/|$)"],
      "note": "See docs/engineering/design-system.md."
    }
  },
  "rules": {
    "shadcn/no-raw-colors": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/no-arbitrary-values": [
      "error",
      { "allow": ["layout", "transition"] }
    ],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^Text$",
            "allow": [
              "layout",
              "truncate",
              "line-clamp-*",
              "whitespace-*",
              "text-balance",
              "text-pretty",
              "break-*",
              "text-start",
              "text-end",
              "text-left",
              "text-center",
              "text-right"
            ]
          },
          { "pattern": "^Icon$", "allow": ["layout"] },
          { "pattern": "^Skeleton$", "allow": ["layout", "shape"] }
        ],
        "message": {
          "spacing": "Use a {{component}} size: {{sizes}}. Margin here or gap on the parent for space around it."
        }
      }
    ]
  },
  "overrides": [
    // Not yet migrated: one override per directory, at warn, so `pnpm lint`
    // passes while the existing violations are fixed. This list is the
    // migration checklist: delete a directory's entry in the PR that brings
    // `pnpm exec oxlint -c .oxlintrc.strict.json <dir> | wc -l` to 0. CI runs
    // the strict config on every .tsx file a PR changes.
    //
    // Each entry repeats the rule options: an oxlint override that sets only
    // a severity resets the rule to its default options.
    {
      "files": ["src/components/atoms/**"],
      "rules": {
        "shadcn/no-raw-colors": "warn",
        "shadcn/require-static-classes": "warn",
        "shadcn/no-inline-styles": "warn",
        "shadcn/no-arbitrary-values": [
          "warn",
          { "allow": ["layout", "transition"] }
        ],
        "shadcn/no-restyle": [
          "warn",
          {
            "allow": ["layout"],
            "contracts": [
              {
                "pattern": "^Text$",
                "allow": [
                  "layout",
                  "truncate",
                  "line-clamp-*",
                  "whitespace-*",
                  "text-balance",
                  "text-pretty",
                  "break-*",
                  "text-start",
                  "text-end",
                  "text-left",
                  "text-center",
                  "text-right"
                ]
              },
              { "pattern": "^Icon$", "allow": ["layout"] },
              { "pattern": "^Skeleton$", "allow": ["layout", "shape"] }
            ],
            "message": {
              "spacing": "Use a {{component}} size: {{sizes}}. Margin here or gap on the parent for space around it."
            }
          }
        ]
      }
    },
