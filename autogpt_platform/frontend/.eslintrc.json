    // Not yet migrated: one override per directory, at warn, so `pnpm lint`
    // passes while the existing violations are fixed. A severity-only entry
    // keeps the options of the rule it lowers. Delete a directory's entry in
    // the PR that brings its count to 0, same as in .oxlintrc.json.
    {
      "files": ["src/components/atoms/**"],
      "rules": {
        "no-restricted-imports": "warn",
        "react/forbid-dom-props": "warn"
      }
