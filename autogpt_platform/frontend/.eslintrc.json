        "src/app/(platform)/copilot/components/ToolChain/SubSessionLive.tsx",
        "src/app/(platform)/copilot/useWakeResync.ts"
      ],
      "rules": { "react-hooks/purity": "warn" }
    },
    {
      "files": [
        "src/app/(platform)/copilot/components/ChatMessagesContainer/components/VirtualTranscript/useQuietRows.ts"
      ],
      "rules": { "react-hooks/refs": "warn" }
    },
    {
      "files": [
        "src/app/(platform)/copilot/components/ApprovalQueue/useApprovalQueue.ts",
        "src/app/(platform)/copilot/components/ArtifactPanel/components/ArtifactReactPreview.tsx",
        "src/app/(platform)/copilot/components/ArtifactPanel/components/useArtifactContent.ts",
        "src/app/(platform)/copilot/components/ArtifactPanel/useArtifactFullscreen.ts",
        "src/app/(platform)/copilot/components/ArtifactPanel/useArtifactPanel.ts",
        "src/app/(platform)/copilot/components/ChatContainer/ChatContainer.tsx",
        "src/app/(platform)/copilot/components/ChatInput/ChatInput.tsx",
        "src/app/(platform)/copilot/components/ChatInput/components/AudioWaveform.tsx",
        "src/app/(platform)/copilot/components/ChatInput/components/ConnectionPicker/useSwap.ts",
        "src/app/(platform)/copilot/components/ChatInput/useChatMentions.ts",
        "src/app/(platform)/copilot/components/ChatInput/useOnboardingMicGlow.ts",
        "src/app/(platform)/copilot/components/ChatInput/useVoiceRecording.ts",
        "src/app/(platform)/copilot/components/ChatMessagesContainer/ChatMessagesContainer.tsx",
        "src/app/(platform)/copilot/components/ChatMessagesContainer/components/TailSpacer.tsx",
        "src/app/(platform)/copilot/components/ChatMessagesContainer/components/useTTSButton.ts",
        "src/app/(platform)/copilot/components/ClarificationQuestionsCard/ClarificationQuestionsCard.tsx",
        "src/app/(platform)/copilot/components/CopilotPendingReviews/useCopilotPendingReviews.ts",
        "src/app/(platform)/copilot/components/CredentialMention/useCredentialMentionEditor.ts",
        "src/app/(platform)/copilot/components/NotificationBanner/NotificationBanner.tsx",
        "src/app/(platform)/copilot/components/OnboardingIntroCard/useOnboardingIntroCard.ts",
        "src/app/(platform)/copilot/components/RateLimitResetDialog/useRateLimitRefresh.ts",
        "src/app/(platform)/copilot/components/ToolChain/ChainRowView.tsx",
        "src/app/(platform)/copilot/components/TurnPausedCard/components/LivePausedCard/useNow.ts",
        "src/app/(platform)/copilot/sharing/useShareChatDialog.ts",
        "src/app/(platform)/copilot/tools/RunAgent/components/AgentDetailsCard/AgentDetailsCard.tsx",
        "src/app/(platform)/copilot/useCopilotReconnect.ts",
        "src/app/(platform)/copilot/useCopilotRuntimeStream.ts",
        "src/app/(platform)/copilot/useCopilotStream.ts",
        "src/app/(platform)/copilot/useLoadMoreMessages.ts",
        "src/app/(platform)/copilot/voice/useVoiceMode.ts",
        "src/app/(platform)/copilot/voice/useVoiceSilenceTimeout.ts"
      ],
      "rules": { "react-hooks/set-state-in-effect": "warn" }
    }
  ]
}
