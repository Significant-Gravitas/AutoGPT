{
  "extends": [
    "next/core-web-vitals",
    "next/typescript",
    "plugin:storybook/recommended",
    "plugin:@tanstack/query/recommended"
  ],
  "rules": {
    // The React Compiler rules from eslint-plugin-react-hooks 7. They warn
    // everywhere and are errors where the compiler runs (see "overrides"),
    // because a file it cannot compile there ships un-memoised, silently.
    "react-hooks/exhaustive-deps": "warn",
    "react-hooks/component-hook-factories": "warn",
    "react-hooks/config": "warn",
    "react-hooks/error-boundaries": "warn",
    "react-hooks/gating": "warn",
    "react-hooks/globals": "warn",
    "react-hooks/immutability": "warn",
    "react-hooks/incompatible-library": "warn",
    "react-hooks/preserve-manual-memoization": "warn",
    "react-hooks/purity": "warn",
    "react-hooks/refs": "warn",
    "react-hooks/set-state-in-effect": "warn",
    "react-hooks/set-state-in-render": "warn",
    "react-hooks/static-components": "warn",
    "react-hooks/unsupported-syntax": "warn",
    "react-hooks/use-memo": "warn",
    // Disable temporarily as we have some `any` in the codebase and we need to got case by case
    // and see if they can be fixed.
    "@typescript-eslint/no-explicit-any": "off",
    // A raw <img> skips next/image sizing and lazy loading. Use next/image, or
    // opt out with `// eslint-disable-next-line @next/next/no-img-element --
    // <reason>` when it can't work (a host next.config.mjs doesn't list, a
    // blob or data URL).
    "@next/next/no-img-element": "error",
    // Allow unused vars that start with underscore (convention for intentionally unused)
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    // Keyboard handlers must go through `isKey()` from `@/lib/keyboard` so that
    // keydowns fired while an IME is composing (Japanese, Chinese, Korean input)
    // are ignored. See AGENTS.md "Keyboard handling".
    //
    // Scope: direct `.key` comparisons and switches against the IME key names
    // (or KEY_* / *_KEY constants). Modifier chords such as Cmd+K, which read
    // `.key.toLowerCase()` or `.code`, are out of scope by design: an IME never
    // owns them. Keep the key list in sync with KEY_NAMES in src/lib/keyboard.ts.
    //
    // The selectors match any receiver, so a domain object that happens to have
    // a `.key` field (e.g. `column.key === "Delete"`) trips them too. That is
    // the one case for `// eslint-disable-next-line no-restricted-syntax`.
    //
    // Both the key list and the selectors are covered by
    // scripts/eslint-keyboard-rules.test.ts.
    "no-restricted-syntax": [
      "error",
      {
        "selector": "BinaryExpression[operator=/^[!=]==?$/]:matches([right.type='Literal'][right.value=/^(Enter|Escape|Tab|ArrowUp|ArrowDown|ArrowLeft|ArrowRight|PageUp|PageDown|Home|End|Backspace|Delete| )$/], [right.type='Identifier'][right.name=/(^KEY_|_KEY$)/]) > MemberExpression.left[computed=false][property.name='key']",
        "message": "Do not compare e.key directly; use isKey(e, \"Enter\") from @/lib/keyboard so IME composition is respected."
      },
      {
        "selector": "BinaryExpression[operator=/^[!=]==?$/]:matches([left.type='Literal'][left.value=/^(Enter|Escape|Tab|ArrowUp|ArrowDown|ArrowLeft|ArrowRight|PageUp|PageDown|Home|End|Backspace|Delete| )$/], [left.type='Identifier'][left.name=/(^KEY_|_KEY$)/]) > MemberExpression.right[computed=false][property.name='key']",
        "message": "Do not compare e.key directly; use isKey(e, \"Enter\") from @/lib/keyboard so IME composition is respected."
      },
      {
        "selector": "SwitchStatement[discriminant.type='MemberExpression'][discriminant.computed=false][discriminant.property.name='key'] > SwitchCase > :matches(Literal[value=/^(Enter|Escape|Tab|ArrowUp|ArrowDown|ArrowLeft|ArrowRight|PageUp|PageDown|Home|End|Backspace|Delete| )$/], Identifier[name=/(^KEY_|_KEY$)/])",
        "message": "Do not switch on e.key directly; use isKey(e, \"Enter\") from @/lib/keyboard so IME composition is respected."
      }
    ],
    // A relative time ("5 minutes ago") reads the clock, and the server's clock
    // and the visitor's never agree: formatted while a server-rendered
    // component renders, it hydrates to different text, React error #418
    // (#17309, #17310). Render <RelativeTime> or call useRelativeTime from
    // @/components/atoms/RelativeTime, which serve the date itself until the
    // page has hydrated. A file that formats one only where no render runs
    // (an event handler, a toast) may join the allow-list, the
    // "no-restricted-imports": "off" override below, with its reason.
    // scripts/eslint-relative-time-rules.test.ts covers the rule and the list.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "date-fns",
            "importNames": ["formatDistanceToNow", "formatDistanceToNowStrict"],
            "message": "It reads the clock, which differs between the server and the browser hydrating its HTML (React error #418). Render <RelativeTime date={…} /> or call useRelativeTime() from @/components/atoms/RelativeTime instead."
          }
        ],
        // Static imports only: require("date-fns"), import("date-fns") and a
        // relative ./time import from inside lib/utils aren't caught, so
        // don't reach the formatters those ways.
        "patterns": [
          {
            "group": ["date-fns/**/formatDistanceToNow*"],
            "message": "It reads the clock, which differs between the server and the browser hydrating its HTML (React error #418). Render <RelativeTime date={…} /> or call useRelativeTime() from @/components/atoms/RelativeTime instead."
          },
          {
            "group": ["**/lib/utils/time"],
            "importNames": ["formatTimeAgo"],
            "message": "It reads the clock, which differs between the server and the browser hydrating its HTML (React error #418). Render <RelativeTime date={…} variant=\"short\" /> or call useRelativeTime(date, \"short\") from @/components/atoms/RelativeTime instead."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // Orval output (gitignored, regenerated by `pnpm generate:api`).
      "files": ["src/app/api/__generated__/**"],
      "rules": {
        "react-hooks/exhaustive-deps": "off",
        "react-hooks/component-hook-factories": "off",
        "react-hooks/config": "off",
        "react-hooks/error-boundaries": "off",
        "react-hooks/gating": "off",
        "react-hooks/globals": "off",
        "react-hooks/immutability": "off",
        "react-hooks/incompatible-library": "off",
        "react-hooks/preserve-manual-memoization": "off",
        "react-hooks/purity": "off",
        "react-hooks/refs": "off",
        "react-hooks/set-state-in-effect": "off",
        "react-hooks/set-state-in-render": "off",
        "react-hooks/static-components": "off",
        "react-hooks/unsupported-syntax": "off",
        "react-hooks/use-memo": "off"
      }
    },
    {
      // The relative-time allow-list: files that may import the formatters
      // that read the clock, each with the reason it never formats one in
      // the server's HTML or in the render that hydrates it. This switches
      // the whole no-restricted-imports rule off for them, so a ban added to
      // that rule later doesn't reach them either.
      "files": [
        // The hook RelativeTime is built on: it returns the date itself until
        // the page has hydrated, and the relative time only after.
        "src/components/atoms/RelativeTime/useRelativeTime.ts"
      ],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // Keep in sync with reactCompilerSources in next.config.mjs, the
      // folders the React Compiler compiles. Tests are never compiled.
      "files": [
        "src/app/(platform)/copilot/**",
        "src/components/organisms/Conversation/**",
        "src/components/organisms/Message/**",
        "src/components/organisms/PromptInput/**"
      ],
      "excludedFiles": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.stories.tsx"
      ],
      "rules": {
        "react-hooks/exhaustive-deps": "error",
        "react-hooks/component-hook-factories": "error",
        "react-hooks/config": "error",
        "react-hooks/error-boundaries": "error",
        "react-hooks/gating": "error",
        "react-hooks/globals": "error",
        "react-hooks/immutability": "error",
        "react-hooks/incompatible-library": "error",
        "react-hooks/preserve-manual-memoization": "error",
        "react-hooks/purity": "error",
        "react-hooks/refs": "error",
        "react-hooks/set-state-in-effect": "error",
        "react-hooks/set-state-in-render": "error",
        "react-hooks/static-components": "error",
        "react-hooks/unsupported-syntax": "error",
        "react-hooks/use-memo": "error"
      }
    },
    // Grandfathered: files that broke one of these rules before the rules
    // existed keep that one rule at "warn" until they are fixed. Every other
    // rule, and every other file, is an error. The list can only shrink:
    // scripts/eslint-rules/compilerLintBaseline.test.ts fails when a listed
    // file no longer breaks its rule, so fixed files must be removed.
    {
      "files": [
        "src/app/(platform)/copilot/components/ArtifactPanel/components/ArtifactContent.tsx"
      ],
      "rules": { "react-hooks/error-boundaries": "warn" }
    },
    {
      "files": [
        "src/app/(platform)/copilot/components/ArtifactCard/ArtifactCard.tsx",
        "src/app/(platform)/copilot/components/ArtifactPanel/components/useArtifactContent.ts",
        "src/app/(platform)/copilot/components/ChainActionCard/ConnectorRow.tsx",
        "src/app/(platform)/copilot/components/ChainActionCard/useExpertCredentialSelection.ts",
        "src/app/(platform)/copilot/components/ChatInput/ChatInput.tsx",
        "src/app/(platform)/copilot/components/ChatMessagesContainer/ChatMessagesContainer.tsx",
        "src/app/(platform)/copilot/components/ChatMessagesContainer/components/VirtualTranscript/useVirtualTranscript.ts",
        "src/app/(platform)/copilot/components/OnboardingIntroCard/useOnboardingIntroCard.ts",
        "src/app/(platform)/copilot/components/OnboardingWelcomeDialog/OnboardingWelcomeDialog.tsx",
        "src/app/(platform)/copilot/components/RateLimitResetDialog/useRateLimitRefresh.ts",
        "src/app/(platform)/copilot/components/SetupRequirementsCard/SetupRequirementsCard.tsx",
        "src/app/(platform)/copilot/components/ToolChain/DesktopStreamCard.tsx",
        "src/app/(platform)/copilot/components/ToolChain/ToolChain.tsx",
        "src/app/(platform)/copilot/tools/RunAgent/components/AgentDetailsCard/AgentDetailsCard.tsx",
        "src/app/(platform)/copilot/useHydrateOnStreamEnd.ts",
        "src/app/(platform)/copilot/useLoadMoreMessages.ts",
        "src/app/(platform)/copilot/useSettleGate.ts",
        "src/app/(platform)/copilot/voice/useVoiceMode.ts",
        "src/components/organisms/Message/Message.tsx"
      ],
      "rules": { "react-hooks/exhaustive-deps": "warn" }
    },
    {
      "files": [
        "src/app/(platform)/copilot/components/ChatMessagesContainer/components/VirtualTranscript/useVirtualTranscript.ts"
      ],
      "rules": { "react-hooks/incompatible-library": "warn" }
    },
    {
      "files": [
        "src/app/(platform)/copilot/components/JobStatsBar/useElapsedTimer.ts",
        "src/app/(platform)/copilot/components/ToolChain/SubSessionLive.tsx",
        "src/app/(platform)/copilot/useWakeResync.ts"
      ],
      "rules": { "react-hooks/purity": "warn" }
    },
    {
      "files": [
        "src/app/(platform)/copilot/components/ChatMessagesContainer/components/VirtualTranscript/useQuietRows.ts"
      ],
      "rules": { "react-hooks/refs": "warn" }
    },
    {
      "files": [
        "src/app/(platform)/copilot/components/ApprovalQueue/useApprovalQueue.ts",
        "src/app/(platform)/copilot/components/ArtifactPanel/components/ArtifactReactPreview.tsx",
        "src/app/(platform)/copilot/components/ArtifactPanel/components/useArtifactContent.ts",
        "src/app/(platform)/copilot/components/ArtifactPanel/useArtifactFullscreen.ts",
        "src/app/(platform)/copilot/components/ArtifactPanel/useArtifactPanel.ts",
        "src/app/(platform)/copilot/components/ChatContainer/ChatContainer.tsx",
        "src/app/(platform)/copilot/components/ChatInput/ChatInput.tsx",
        "src/app/(platform)/copilot/components/ChatInput/components/AudioWaveform.tsx",
        "src/app/(platform)/copilot/components/ChatInput/components/ConnectionPicker/useSwap.ts",
        "src/app/(platform)/copilot/components/ChatInput/useChatMentions.ts",
        "src/app/(platform)/copilot/components/ChatInput/useOnboardingMicGlow.ts",
        "src/app/(platform)/copilot/components/ChatInput/useVoiceRecording.ts",
        "src/app/(platform)/copilot/components/ChatMessagesContainer/ChatMessagesContainer.tsx",
        "src/app/(platform)/copilot/components/ChatMessagesContainer/components/TailSpacer.tsx",
        "src/app/(platform)/copilot/components/ChatMessagesContainer/components/useTTSButton.ts",
        "src/app/(platform)/copilot/components/ClarificationQuestionsCard/ClarificationQuestionsCard.tsx",
        "src/app/(platform)/copilot/components/CopilotPendingReviews/useCopilotPendingReviews.ts",
        "src/app/(platform)/copilot/components/CredentialMention/useCredentialMentionEditor.ts",
        "src/app/(platform)/copilot/components/OnboardingIntroCard/useOnboardingIntroCard.ts",
        "src/app/(platform)/copilot/components/RateLimitResetDialog/useRateLimitRefresh.ts",
        "src/app/(platform)/copilot/components/ToolChain/ChainRowView.tsx",
        "src/app/(platform)/copilot/components/TurnPausedCard/components/LivePausedCard/useNow.ts",
        "src/app/(platform)/copilot/sharing/useShareChatDialog.ts",
        "src/app/(platform)/copilot/tools/RunAgent/components/AgentDetailsCard/AgentDetailsCard.tsx",
        "src/app/(platform)/copilot/useCopilotReconnect.ts",
        "src/app/(platform)/copilot/useCopilotRuntimeStream.ts",
        "src/app/(platform)/copilot/useCopilotStream.ts",
        "src/app/(platform)/copilot/useLoadMoreMessages.ts",
        "src/app/(platform)/copilot/voice/useVoiceMode.ts",
        "src/app/(platform)/copilot/voice/useVoiceSilenceTimeout.ts"
      ],
      "rules": { "react-hooks/set-state-in-effect": "warn" }
    }
  ]
}
