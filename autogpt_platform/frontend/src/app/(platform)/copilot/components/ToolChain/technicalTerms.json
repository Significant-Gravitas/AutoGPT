  "fragments": {
    "ARG": "[\\w~/-]+(?:\\.[\\w~/-]+)*",
    "SEGMENT": "\\.?[\\w-]+(?:\\.[\\w-]+)*",
    "POSITION": "(?:^|[.!?]\\s+|\\b(?:{RUN_VERBS})\\s+)"
  },
  "certain": [
    {
      "rule": "capability id",
      "pattern": "\\b(?:{CAPABILITY_KINDS}):[\\w-]+"
    },
    {
      "rule": "SDK tool name",
      "pattern": "\\b(?:{SDK_TOOL_NAMES:exact})\\b"
    },
    {
      "rule": "SDK tool named by an English word, shown as a tool",
      "pattern": "`({SDK_WORD_TOOLS})`|\\b({SDK_WORD_TOOLS})(?=\\s+(?:{TOOL})\\b)"
    },
    {
      "rule": "path",
      "pattern": "(?:^|[\\s`'\"(])((?:~|\\.{1,2})?/{SEGMENT}(?:/{SEGMENT})+|(?:~|\\.{1,2})/{SEGMENT}|/(?:{SYSTEM_ROOTS})\\b)"
    },
    {
      "rule": "file name",
      "pattern": "\\b[\\w-]+\\.(?:{FILE_EXTENSIONS})\\b"
    },
    {
      "rule": "script file name, not a product such as Next.js",
      "pattern": "\\b(?!(?:{SCRIPT_PRODUCTS})\\.(?:{SCRIPT_EXTENSIONS})\\b)[\\w-]+\\.(?:{SCRIPT_EXTENSIONS})\\b"
    },
    {
      "rule": "command with a flag or a path",
      "pattern": "\\b(?:{WORDLIKE}|{CODE_ONLY})\\s+(?:-{1,2}[A-Za-z][\\w-]*|[~./]\\S*)"
    },
    {
      "rule": "git subcommand",
      "pattern": "\\b(?:{GIT})\\s+(?:{GIT_SUBCOMMANDS})\\b"
    },
    {
      "rule": "package manager subcommand",
      "pattern": "\\b(?:{PACKAGE_MANAGERS})\\s+(?:{PACKAGE_SUBCOMMANDS})\\b"
    },
    {
      "rule": "command in command position",
      "pattern": "{POSITION}(?:[`'\"]((?:{WORDLIKE}|{CODE_ONLY})\\s+{ARG})|((?:{CODE_ONLY:noabbr})\\s+{ARG}))"
    },
    {
      "rule": "shell operator",
      "pattern": "&&|\\|\\||\\$\\("
    },
    {
      "rule": "pipe into a command",
      "pattern": "\\|\\s*(?:{CODE_ONLY:noabbr})\\b"
    },
    {
      "rule": "command that is never a word",
      "pattern": "\\b(?:{BARE_COMMANDS:noabbr})\\b"
    },
    {
      "rule": "identifier",
      "pattern": "\\b[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)+\\b"
    },
    {
      "rule": "uuid",
      "pattern": "\\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\b"
    }
  ],
  "possible": [
    {
      "rule": "everyday-word command before an argument, in command position",
      "pattern": "{POSITION}((?:{WORDLIKE:noabbr})\\s+(?!(?:{FUNCTION_WORDS})\\b){ARG})"
    },
    {
      "rule": "command that is also a word",
      "pattern": "\\b(?:{BARE_WORDS:noabbr})\\b"
    },
    {
      "rule": "inline code",
      "pattern": "`[^`\\n]*`?"
    },
    {
      "rule": "token with two slashes, not a URL",
      "pattern": "(?:^|\\s)((?![A-Za-z][\\w+.-]*:)[^\\s/]+/[^\\s/]*/\\S*)"
    },
    {
      "rule": "two lowercase words joined by a slash, not a prose pair",
      "pattern": "(?:^|[^\\w./])(?!(?:{PROSE_PAIRS:exact})\\b)([a-z][\\w-]*/[a-z][\\w-]*)\\b"
    },
    {
      "rule": "a slash opening a word",
      "pattern": "(?:^|\\s)([~.]?/\\w[\\w.-]*)"
    }
  ],
