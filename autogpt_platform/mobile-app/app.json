{
  "expo": {
    "name": "AutoGPT",
    "slug": "autogpt-mobile",
    "owner": "autogpt",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3fdedc8c-8a9e-4002-a95a-ab366d15cd71"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "autogpt-app",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0D",
    "ios": {
      "bundleIdentifier": "co.agpt.autogpt.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.agpt.autogpt.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/images/icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to your chats.",
          "cameraPermission": false,
          "microphonePermission": "Dictate your messages."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Dictate your messages.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sqlite",
      [
        "@sentry/react-native",
        {
          "organization": "significant-gravitas",
          "project": "autogpt-mobile",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3fdedc8c-8a9e-4002-a95a-ab366d15cd71"
      }
    }
  }
}
