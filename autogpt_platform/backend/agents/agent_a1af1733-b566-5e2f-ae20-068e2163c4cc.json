{
  "id": "2ec2f82c-2928-5252-9ebf-184c98a22167",
  "version": 1,
  "is_active": true,
  "name": "Lifecycle Email Sequence Builder",
  "description": "Turn a product and an audience into a lifecycle email sequence that is mapped before it is written. The workflow first lays out which emails should exist at all \u2014 the moment each one attaches to, the trigger that fires it, its single goal and the one action it asks for \u2014 and only then drafts them. Works for welcome, onboarding, nurture and win-back sequences. Timing is anchored to behaviour rather than to a fixed calendar, every email has an exit, and anything the drafts cannot know is left as a marked gap rather than invented.",
  "instructions": null,
