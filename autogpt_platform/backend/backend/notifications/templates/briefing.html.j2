{%- import "_email_ui.j2" as ui with context -%}
{%- set quiet = mode | default('standard') == 'quiet' -%}
{%- set attn = attention | default([]) -%}
{%- set failed = totals.failed | default(0) -%}
<!doctype html>
<html lang="en">
<head>{{ ui.head_block(subject) }}</head>
{{ ui.body_open() }}
{{ ui.preheader(preheader) }}
{{ ui.page_open() }}
{{ ui.masthead() }}
{{ ui.hero_otto() }}
{{ ui.sheet_open() }}
{% call ui.eyebrow(tone='needs_you' if attn else ('confirmed' if failed == 0 else 'neutral')) %}THE BRIEFING · {{ period.label | upper }}{% endcall %}
{% call ui.headline() %}{{ subject }}{% endcall %}
{% call ui.para() %}Hi {{ first_name | default('there', true) }}, here is your {{ period.adjective }} in workflows. {{ preheader }}{% endcall %}
{% if quiet and only_agent %}
{% call ui.para() %}{{ only_agent }} was your only workflow at work {{ period.noun }}. {{ quiet_summary | default('Nothing needed your attention.', true) }}{% endcall %}
{% elif standout %}
{% call ui.para() %}{{ standout }}{% endcall %}
{% endif %}
{% for item in attn[:3] %}
<tr><td class="gutter" style="padding:{{ '22px' if loop.first else '12px' }} 48px 0;">{{ ui.attention_card(item, primary=loop.first) }}</td></tr>
{% endfor %}
{% if attn | length > 3 %}
{% call ui.para(size=14, lh=21) %}+ {{ attn | length - 3 }} more {{ 'thing needs' if attn | length == 4 else 'things need' }} you. <a href="{{ urls.attention }}" style="color:#6144DF; font-weight:600; text-decoration:underline;">Review everything waiting</a>{% endcall %}
{% endif %}
{% if highlights %}
{% set rows = [] %}
{% for h in highlights[:3] %}{% set _ = rows.append((h.agent, h.gist, h.link_label, h.url)) %}{% endfor %}
{{ ui.also_panel('Worth a look', rows) }}
{% endif %}
{{ ui.kvpanel([('Runs', '{:,}'.format(totals.runs), true), ('Active workflows', totals.agents_active, true), ('Workflows on standby', totals.agents_idle | default(0), true), ('Failed runs', failed, true), ('Credits used', '{:,.2f}'.format(totals.credits_used) ~ (' ($' ~ '{:,.2f}'.format(totals.usd_estimate) ~ ')' if totals.usd_estimate is not none else ''), true), ('Credit balance', '{:,.2f}'.format(totals.credits_balance), true)]) }}
{% if not quiet %}
{% call ui.note_card('The ledger') %}
{% for row in ledger %}
<div style="{{ 'padding-top:12px; margin-top:12px; border-top:1px solid #E7E4F4;' if not loop.first }}">
<strong style="color:#171925;">{{ row.agent }}</strong><br>
<span style="font-family:{{ ui.MONO }}; font-size:13px;">{{ '{:,}'.format(row.runs) }} {{ 'run' if row.runs == 1 else 'runs' }} · {{ '%.2f' | format(row.credits) }} credits</span><br>
<span style="font-size:14px; color:{{ '#B45309' if row.issues_label else '#575072' }};">{{ row.issues_label or 'No issues' }}</span>
</div>
{% endfor %}
{% if ledger_overflow %}
<div style="padding-top:12px; font-size:14px;">+ {{ ledger_overflow }} quieter {{ 'workflow' if ledger_overflow == 1 else 'workflows' }} ran {{ '{:,}'.format(ledger_overflow_runs) }} {{ 'time' if ledger_overflow_runs == 1 else 'times' }}{{ ', with no issues' if ledger_overflow_issues == 0 else ', ' ~ ledger_overflow_issues ~ ' with issues' }}.</div>
{% endif %}
{% endcall %}
{% endif %}
{% call ui.para(size=14, lh=21) %}<a href="{{ urls.dashboard }}" style="color:#6144DF; font-weight:600; text-decoration:underline;">Review run history</a>{% endcall %}
{{ ui.volume_knob(urls.volume, current=period.frequency) }}
{{ ui.sheet_close() }}
{{ ui.page_close() }}
{{ ui.product_footer('This is your Briefing for ' ~ user_email ~ '.', urls.unsubscribe) }}
</td></tr></table>
</body></html>
