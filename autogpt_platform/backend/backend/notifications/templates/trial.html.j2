{%- import "_email_ui.j2" as ui with context -%}
{%- import "_trial_copy.j2" as copy with context -%}
<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>{{ ui.head_block(subject) }}</head>
{{ ui.body_open() }}
{{ ui.preheader(preheader) }}
{{ ui.page_open() }}
{{ ui.masthead() }}
{{ ui.hero_otto() }}
{% if kind == 'payment_failed' %}{{ ui.strip_amber('NEEDS YOU · PAYMENT DECLINED') }}{% endif %}
{{ ui.sheet_open() }}
{% call ui.eyebrow(tone='confirmed' if kind in ['started', 'resumed', 'converted'] else 'needs_you' if kind == 'payment_failed' else 'neutral') %}YOUR AUTOGPT TRIAL{% endcall %}
{% call ui.headline() %}{{ subject }}{% endcall %}
{% call ui.para() %}{{ copy.lede() }}{% endcall %}
{% if kind == 'converted' %}{{ ui.kvpanel([('Plan', plan.label, false)] + ([('Started', started_label, true)] if started_label else []) + [('Price', plan.price_display, true)]) }}{% else %}{{ ui.kvpanel([('Plan', plan.label, false), ('Trial ended' if kind == 'ended' else 'Trial ends', ends_label, true), ('Paid price', plan.price_display, true)]) }}{% endif %}
{% if copy.detail() | trim %}{% call ui.para() %}{{ copy.detail() }}{% endcall %}{% endif %}
{% if kind == 'converted' %}
{{ ui.cta('Open AutoGPT', urls.dashboard) }}
{{ ui.also_panel('Three good places to start', [
    ('The quick-start guide.', 'Set up your first task, step by step.', 'Open the guide', urls.docs),
    ('The Marketplace.', 'Find a workflow for the work you need done.', 'Browse workflows', urls.marketplace),
    ('Discord.', 'See what other people are building.', 'Join in', urls.discord),
]) }}
{% elif kind == 'ended' %}
{{ ui.cta('Choose a plan', urls.billing) }}
{% else %}
{{ ui.cta('Update payment method' if kind == 'payment_failed' else 'Review your plan', urls.billing) }}
{% endif %}
{{ ui.close_row('You received this because your trial status changed or its end is approaching.', 'Billing settings', urls.billing) }}
{{ ui.sheet_close() }}
{{ ui.page_close() }}
{{ ui.legal_footer("This is a service message about the AutoGPT account for " ~ user_email ~ ". It's sent even if you've opted out of product news.", 'Email preferences', urls.prefs, discord=true) }}
</td></tr></table>
</body></html>
