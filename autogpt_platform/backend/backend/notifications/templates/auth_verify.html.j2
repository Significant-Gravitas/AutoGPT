{#- ============================================================
    auth_verify.html.j2: "Confirm your email address", the link that
    verifies an account's email. Unlike the compact auth layout it
    carries the Otto hero, since it is often the first email a new
    user gets.
    Context: content (AuthEmailContent), action_url, assets, urls
    ============================================================ -#}
{%- import '_email_ui.j2' as ui with context -%}
<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>{{ ui.head_block(content.subject) }}</head>
{{ ui.body_open() }}
{{ ui.preheader(content.preheader) }}
{{ ui.page_open() }}
{{ ui.masthead() }}
{{ ui.hero_otto() }}
{{ ui.sheet_open() }}
{% call ui.eyebrow(tone='brand') %}{{ content.eyebrow }}{% endcall %}
{% call ui.headline() %}{{ content.headline }}{% endcall %}
{% call ui.para() %}{{ content.intro }}{% endcall %}
{{ ui.cta(content.action, action_url, micro='The link expires in ' ~ content.expiry ~ '.' if content.expiry else none) }}
{% call ui.para(top=28) %}{{ ui.section_label('WHERE YOU ARE') }}{% endcall %}
{{ ui.steps(content.steps, top=12) }}
{% call ui.note_card('Button not working?') %}Copy this link into your browser:
<div style="padding-top:6px; font-family:{{ ui.MONO }}; font-size:12px; line-height:18px;"><a href="{{ action_url }}" style="color:#4D36AD; text-decoration:underline; overflow-wrap:anywhere; word-break:break-all;">{{ action_url }}</a></div>
{% endcall %}
{% call ui.para(top=20, color='#575072', size=13, lh=20) %}If you didn't request this, you can safely ignore this email. The address won't be confirmed without this link.{% endcall %}
{{ ui.close_row(content.reason, 'Something wrong? Ask in Discord', urls.discord) }}
{{ ui.sheet_close() }}
{{ ui.page_close() }}
{{ ui.legal_footer("This is a service message about an AutoGPT account. It's sent even if you've opted out of product news.", 'Discord', urls.discord) }}
</td></tr></table>
</body></html>
