# This Dockerfile builds backend and single-container targets. Keep its context
# independent from the root .dockerignore, whose frontend image intentionally
# accepts deployment env files at build time. No env file belongs in this
# Dockerfile's context or exported BuildKit cache.
*

!docs/
!autogpt_platform/autogpt_libs/
!autogpt_platform/backend/
!autogpt_platform/frontend/
!autogpt_platform/single-container/
!autogpt_platform/db/init/00-init.sql
!autogpt_platform/LICENSE.md

**/.*

**/__pycache__/
**/*.pyc
**/*.pyo
**/.venv/
**/.ruff_cache/
**/.pytest_cache/
**/.coverage
**/htmlcov/

**/node_modules/
**/.next/
**/coverage/
**/storybook-static/
**/playwright-report/
**/test-results/
**/next-env.d.ts
**/tsconfig.tsbuildinfo
**/src/app/api/__generated__/

**/dist/
**/build/
!autogpt_platform/frontend/src/**/build/
**/target/

**/*.log
**/*.tmp
