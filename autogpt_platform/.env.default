############
# Database
#
# Docker Compose reads autogpt_platform/.env (`make init-env` creates it from
# this file) for the `db` service and for every service's connection string.
#
# POSTGRES_PASSWORD is left blank on purpose: this file is public, so a value
# here would be a published password. `make init-env` generates one for your
# install and copies it to DB_PASS in backend/.env and to DATABASE_URL in
# frontend/.env, which the backend and frontend use outside Docker. The
# database takes this value every time it starts. To change it, change all
# three (or clear all three and run `make init-env`) and restart the stack as
# "Upgrading: service passwords are generated per install" in
# docs/platform/getting-started.md describes: the restart recreates RabbitMQ,
# which empties its queues. It goes into connection strings as is, so stick to
# letters, digits, `-`, `_`, `.` and `~`. Compose takes a POSTGRES_PASSWORD set
# in your shell over this file, so don't export one there.
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# default user is postgres
POSTGRES_PASSWORD=
