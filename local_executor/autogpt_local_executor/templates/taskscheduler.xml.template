<?xml version="1.0" encoding="UTF-16"?>
<!--
  Source template: autogpt_local_executor/templates/taskscheduler.xml.template
  Rendered file:   %LOCALAPPDATA%\autogpt-local-executor\autogpt-shim.xml
  Re-render with:  autogpt-shim install

  The task is one account's own: the logon trigger and the principal both
  name the account that ran `autogpt-shim install`, so it starts the shim
  at that account's logon and runs it as that account. A task that names
  no account is one for every account's logon, which only an administrator
  may register.

  Register the rendered task, in a prompt of that account's (it takes no
  elevated one), with:
    schtasks /Create /TN "AutoGPT\Shim" /XML "%LOCALAPPDATA%\autogpt-local-executor\autogpt-shim.xml"

  End it and remove it, from such a prompt too, with:
    autogpt-shim uninstall

  Task Scheduler doesn't start a program again after it exits: its
  restart-on-failure setting applies when the action can't be started at
  all. So the action runs `start` with its supervise option, with which the
  shim starts its daemon again itself after an exit that asks for it (75) or
  a crash, as launchd and systemd do for it elsewhere.

  The task has no network condition. With one, Task Scheduler runs a task
  only when a network is available, which at a logon it may not be yet
  (Wi-Fi that connects a little later), and its setting for starting a task
  once a missed start becomes possible is for time-based triggers, not this
  one. The shim waits for the platform itself, with or without a network
  when it starts.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>AutoGPT Local PC Executor shim</Description>
    <URI>\AutoGPT\Shim</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>{user_id}</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>{user_id}</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{command}</Command>
      <Arguments>{arguments}</Arguments>
    </Exec>
  </Actions>
</Task>
