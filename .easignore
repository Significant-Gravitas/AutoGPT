# EAS Build uploads from the repository root. Only the mobile app is needed.
# This file replaces .gitignore for EAS, so the app's own ignores are repeated below.
/*
!/autogpt_platform
/autogpt_platform/*
!/autogpt_platform/mobile-app

node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
/autogpt_platform/mobile-app/ios
/autogpt_platform/mobile-app/android
